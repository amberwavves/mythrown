---
const socials = [
  {
    label: "Instagram",
    href: "https://www.instagram.com/thrownokc/",
  },
];
---

<aside class="fixed bottom-4 right-4 z-40 md:bottom-6 md:right-6">
  <div class="flex items-center gap-2 rounded-full border border-black/10 bg-[color:var(--color-bg)]/95 px-3 py-2 shadow-lg backdrop-blur-md">
    <a
      href="https://www.instagram.com/thrownokc/"
      target="_blank"
      rel="noopener"
      aria-label="Follow @ThrownOKC on Instagram"
      class="inline-flex items-center gap-2 rounded-full bg-black text-white px-4 py-2 text-xs tracking-widest uppercase transition-colors hover:bg-[color:var(--color-cherry)]"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5a4.25 4.25 0 0 0 4.25 4.25h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5a4.25 4.25 0 0 0-4.25-4.25h-8.5Zm8.88 2.22a1.03 1.03 0 1 1 0 2.06 1.03 1.03 0 0 1 0-2.06ZM12 6.8A5.2 5.2 0 1 1 6.8 12 5.2 5.2 0 0 1 12 6.8Zm0 1.5A3.7 3.7 0 1 0 15.7 12 3.71 3.71 0 0 0 12 8.3Z"/>
      </svg>
      <span>@ThrownOKC</span>
    </a>

    <div class="hidden sm:flex items-center gap-2 pl-1 text-[0.65rem] tracking-[0.35em] uppercase text-[color:var(--color-muted)]">
      <span class="h-px w-6 bg-black/15"></span>
      <span>Social</span>
    </div>
  </div>
</aside>