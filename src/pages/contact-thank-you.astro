---
import Base from "../layouts/Base.astro";
import StatueBand from "../components/StatueBand.astro";
---

<Base title="Inquiry Sent | THROWN">
  <StatueBand />
  <section class="px-6 pt-20 pb-28">
    <div class="max-w-2xl mx-auto text-center">
      <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">Inquiry Received</div>
      <h1 class="mt-3 text-5xl md:text-7xl font-brand-script tracking-[0.01em]">Thank you.</h1>
      <p class="mt-6 text-base md:text-lg leading-relaxed max-w-xl mx-auto">
        Your inquiry has been sent. We will review your details and follow up within two business days.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-block px-6 py-3 bg-[color:var(--color-cherry)] text-white text-sm md:text-base tracking-[0.12em] uppercase hover:bg-[#645e26] transition-colors"
        >
          Back to Home
        </a>
        <a
          href="/portfolio"
          class="inline-block px-6 py-3 border border-black/40 text-sm md:text-base tracking-[0.12em] uppercase hover:bg-black/5 transition-colors"
        >
          View Portfolio
        </a>
      </div>
    </div>
  </section>
</Base>
