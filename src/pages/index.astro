---
import Base from "../layouts/Base.astro";
---

<Base>
  <section
    class="relative overflow-hidden min-h-[80vh] md:min-h-[90vh] flex items-end bg-cover bg-center bg-no-repeat"
    style="background-image: url('/images/statue.png');"
  >
    <div class="relative px-6 pt-24 pb-20 md:pt-40 md:pb-28 w-full">
      <div class="max-w-7xl mx-auto">
        <h1 class="font-black leading-[0.85] tracking-tight text-[22vw] md:text-[16vw] text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.5)]">
          THROWN
        </h1>
        <p class="mt-8 uppercase text-white whitespace-nowrap font-semibold tracking-[0.15em] text-[clamp(0.7rem,2.1vw,1.75rem)]">
          Commercial + Residential Interior Design by Amber Foster
        </p>
        <div class="mt-12 flex flex-wrap gap-4">
          <a href="/commercial" class="px-6 py-3 bg-black text-white text-xs tracking-widest uppercase hover:bg-neutral-800 transition-colors">
            Commercial Portfolio
          </a>
          <a href="/residential" class="px-6 py-3 bg-black text-white text-xs tracking-widest uppercase hover:bg-neutral-800 transition-colors">
            Residential Portfolio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-24 border-t border-black/10">
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-12">
      <div>
        <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">01 — Studio</div>
        <h2 class="mt-3 text-2xl md:text-3xl font-semibold leading-tight">Spaces that feel inevitable.</h2>
      </div>
      <p class="md:col-span-2 text-lg leading-relaxed">
        THROWN is the studio of Amber Foster, designing commercial and residential interiors
        rooted in material honesty, calm restraint, and a sharp point of view. Based in the
        Wheeler District. Working nationally.
      </p>
    </div>
  </section>

  <section class="px-6 py-24 border-t border-black/10">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-6">
      <a href="/commercial" class="group relative aspect-[4/3] overflow-hidden block">
        <img src="/images/commercial/commercial-01.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-8 text-white">
          <div class="text-xs tracking-widest uppercase opacity-80">Portfolio</div>
          <div class="mt-1 text-3xl md:text-4xl font-black">Commercial</div>
        </div>
      </a>
      <a href="/residential" class="group relative aspect-[4/3] overflow-hidden block">
        <img src="/images/residential/residential-01.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-8 text-white">
          <div class="text-xs tracking-widest uppercase opacity-80">Portfolio</div>
          <div class="mt-1 text-3xl md:text-4xl font-black">Residential</div>
        </div>
      </a>
    </div>
  </section>

  <section class="px-6 py-24 border-t border-black/10">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">Visit the Shop</div>
        <h2 class="mt-3 text-3xl md:text-5xl font-black tracking-tight">Wine + decor in the Wheeler District.</h2>
        <p class="mt-6 text-lg leading-relaxed">
          Our brick-and-mortar pairs a tightly curated wine list with the same considered decor
          you'd find in our projects. Stop in to browse, sip, and take something home.
        </p>
        <a href="/shop" class="inline-block mt-8 px-6 py-3 bg-[color:var(--color-cherry)] text-white text-xs tracking-widest uppercase hover:bg-[color:var(--color-cherry-soft)] transition-colors">
          Visit the Shop
        </a>
      </div>
      <div class="aspect-[4/5] overflow-hidden">
        <img src="/images/shop/shop-01.jpg" alt="THROWN storefront" loading="lazy" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>
</Base>
