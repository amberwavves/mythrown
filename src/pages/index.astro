---
import Base from "../layouts/Base.astro";
---

<Base>
  <section
    class="relative overflow-hidden min-h-[80vh] md:min-h-[90vh] flex items-end bg-cover bg-center bg-no-repeat"
    style="background-image: url('/images/statue.png');"
  >
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative px-6 pt-24 pb-20 md:pt-40 md:pb-28 w-full">
      <div class="max-w-7xl mx-auto -translate-y-3 md:-translate-y-4">
        <div class="relative inline-block w-full -ml-4 md:ml-0">
          <h1 class="home-hero-thrown relative z-10 font-black leading-[0.86] tracking-[-0.03em] text-[19vw] md:text-[18vw] text-[#893521] drop-shadow-[0_4px_24px_rgba(0,0,0,0.35)]">
            THROWN
          </h1>
          <p class="home-hero-subtext-script mt-1 ml-2 md:ml-0 max-w-[88vw] md:max-w-none md:absolute md:left-10 md:top-[76%] z-20 text-white whitespace-normal md:whitespace-nowrap text-[clamp(0.95rem,4.8vw,3rem)] md:text-[clamp(1.3rem,3.2vw,3rem)] leading-[0.95] md:leading-none drop-shadow-[0_2px_10px_rgba(0,0,0,0.45)]">
            <span class="block whitespace-nowrap md:inline">commercial + residential interior design</span>
            <span class="block mt-1 -ml-1 whitespace-nowrap md:ml-0 md:mt-0 md:inline">by amber foster</span>
          </p>
        </div>
        <div class="mt-12 ml-5 md:ml-10 flex flex-wrap gap-4">
          <a href="/commercial" class="font-aliens-cows px-7 py-3.5 bg-[#3b0f1a] text-white text-lg md:text-xl tracking-wide uppercase hover:bg-[#2f0b15] transition-colors">
            Commercial Portfolio
          </a>
          <a href="/residential" class="font-aliens-cows px-7 py-3.5 bg-[#3b0f1a] text-white text-lg md:text-xl tracking-wide uppercase hover:bg-[#2f0b15] transition-colors">
            Residential Portfolio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-24 border-t border-black/10">
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-12">
      <div>
        <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">01 — Studio</div>
        <h2 class="mt-3 text-2xl md:text-3xl font-semibold leading-tight">Experience design <span class="font-brand-script text-[#45519f]">redefined.</span></h2>
      </div>
      <p class="md:col-span-2 text-xl md:text-2xl leading-relaxed font-aliens-cows bg-[#eee9e2] border border-[#633b2f]/15 p-9 md:p-12">
        Thrown is the studio of <span class="font-brand-script whitespace-nowrap">Amber Foster</span>, designing commercial and residential interiors
        that are functional and design&nbsp;driven.
      </p>
    </div>
  </section>

  <section class="relative overflow-hidden px-6 pt-14 pb-24 border-t border-black/10 bg-[#111111]">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 bg-[url('/images/statue.png')] bg-cover bg-center opacity-[0.14]"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto grid md:grid-cols-2 gap-6">
      <a href="/commercial" class="group relative aspect-[4/3] overflow-hidden block border border-[#645e26]">
        <img src="/images/commercial/commercial-01.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <h2 class="mt-0 text-3xl md:text-5xl font-black tracking-[0.04em] md:tracking-[0.06em]"><span class="font-brand-script normal-case block leading-none">Design + Wine</span><span class="block mt-3 md:mt-4 text-xl md:text-3xl">in the Wheeler District of OKC.</span></h2>
        <div class="absolute inset-0 flex flex-col justify-end p-8 text-white">
          <div class="text-xs tracking-widest uppercase opacity-80">Portfolio</div>
          <div class="mt-1 text-3xl md:text-4xl font-black">Commercial</div>
        </div>
      </a>
      <a href="/residential" class="group relative aspect-[4/3] overflow-hidden block border border-[#645e26]">
        <img src="/images/residential/residential-01.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-8 text-white">
          <div class="text-xs tracking-widest uppercase opacity-80">Portfolio</div>
          <div class="mt-1 text-3xl md:text-4xl font-black">Residential</div>
        </div>
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden px-6 pt-8 pb-24 md:py-24">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 bg-[url('/images/statue.png')] bg-cover bg-center opacity-[0.08] [mask-image:linear-gradient(to_bottom,transparent_0%,black_22%,black_100%)]"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-start">
      <div>
        <div class="relative z-10 mb-2 text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">1712 SPOKE ST</div>
        <h2 class="mt-0 text-3xl md:text-5xl font-black tracking-[0.04em] md:tracking-[0.06em]"><span class="font-brand-script normal-case block leading-none">Design + Wine</span><span class="block mt-3 md:mt-4">in the Wheeler District.</span></h2>
        <p class="mt-6 text-xl md:text-2xl leading-relaxed font-aliens-cows">
          Our brick-and-mortar is both our design studio and a thoughtfully curated wine & gift boutique in the heart of the Wheeler District in OKC. Stop in and say hello.
        </p>
        <a href="/shop" class="inline-block mt-8 px-6 py-3 bg-[color:var(--color-cherry)] text-white text-xs tracking-widest uppercase hover:bg-[#45519f] active:bg-[#45519f] transition-colors">
          Visit the Shop
        </a>
      </div>
      <div class="archive-frame">
        <div class="archive-frame-profile">
          <div class="archive-frame-mat aspect-[4/5] overflow-hidden">
            <img src="/images/shop/shop-01.jpg" alt="THROWN storefront" loading="lazy" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .archive-frame {
    border: 1px solid #5c4516;
    background: linear-gradient(145deg, #6b4b15 0%, #9b7322 14%, #e0c171 36%, #b8842a 56%, #f0d999 78%, #876118 100%);
    padding: 7px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
  }

  .archive-frame-profile {
    border: 1px solid #7b5a1a;
    background:
      linear-gradient(180deg, rgba(255, 244, 210, 0.42), rgba(126, 90, 22, 0.22)),
      linear-gradient(155deg, #e8cf86 0%, #bb8a30 48%, #f3dfa6 100%);
    padding: 10px;
    box-shadow:
      inset 0 1px 1px rgba(255, 248, 226, 0.75),
      inset 0 -1px 1px rgba(94, 66, 14, 0.45);
  }

  .archive-frame-mat {
    border: 1px solid #d8ccb0;
    padding: 12px;
    background:
      radial-gradient(circle at 1px 1px, rgba(143, 126, 96, 0.14) 0 0.6px, transparent 0.8px),
      linear-gradient(180deg, #f8f3e8 0%, #efe7d8 100%);
    background-size: 10px 10px, 100% 100%;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.72),
      inset 0 -1px 2px rgba(154, 135, 103, 0.22);
  }

  .archive-frame-mat img {
    border: 1px solid #3a2e1c;
  }

  @media (max-width: 767px) {
    .archive-frame {
      padding: 4px;
      box-shadow: 0 8px 14px rgba(0, 0, 0, 0.18);
    }

    .archive-frame-profile {
      padding: 6px;
    }

    .archive-frame-mat {
      padding: 7px;
      background-size: 9px 9px, 100% 100%;
    }
  }
</style>

