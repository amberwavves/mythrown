---

<Base title="Favves | THROWN" description="Monthly favorites — pieces in the shop and pieces you can order.">
  <StatueBand />
  <section class="px-6 pt-16 pb-12">
    <div class="max-w-7xl mx-auto">
      <div class="-mt-1 text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">June 2026</div>
      <h1 class="mt-3 text-5xl md:text-7xl font-black tracking-tight leading-[0.9]">
        <span class="block font-brand-script normal-case">Fa<span class="inline-block tracking-[0.03em]">vv</span>es</span>
        <span class="block mt-2 text-3xl md:text-5xl font-semibold tracking-normal wave-line" aria-label="of amberwavves">
          <span class="wave-prefix" aria-hidden="true">of&nbsp;</span><span class="wave-word" aria-hidden="true"><span style="--i:0">a</span><span style="--i:1">m</span><span style="--i:2">b</span><span style="--i:3">e</span><span style="--i:4">r</span><span style="--i:5">w</span><span style="--i:6">a</span><span style="--i:7">v</span><span style="--i:8">v</span><span style="--i:9">e</span><span style="--i:10">s</span></span>
        </span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed">
        A short list of things we're loving right now — split between pieces sitting in the shop
        and pieces you can order through us. Refreshed monthly.
      </p>
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-baseline justify-between border-b border-[color:var(--color-ink)]/15 pb-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-black tracking-[0.04em]">In Store while supplies last</h2>
        <span class="text-xs tracking-widest uppercase text-[color:var(--color-muted)]">1712 Spoke St</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {inStore.map((p) => (
          <button
            type="button"
            class="group block text-left w-full"
            data-favve-title={p.name}
            data-favve-note={p.note}
            data-favve-details={p.details?.join(" | ") ?? ""}
            data-favve-description={p.description ?? ""}
            data-favve-price={p.price ?? ""}
            data-favve-image={p.image ?? ""}
            data-favve-gallery={p.gallery?.join(" | ") ?? ""}
            data-favve-gallery-positions={p.galleryPositions?.join(" | ") ?? ""}
            data-favve-image-fit={p.imageFit ?? "cover"}
            data-favve-brand-values={p.brandValues?.join(" | ") ?? ""}
            data-favve-section="in-store"
          >
            <div class="aspect-square bg-white overflow-hidden border border-black/10">
              {p.image ? (
                <img
                  src={p.image}
                  alt={p.name}
                  loading="lazy"
                  class={`w-full h-full ${p.imageFit === "contain" ? "object-contain p-2" : "object-cover"} group-hover:scale-105 transition-transform duration-500`}
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-amber-100 to-stone-300 group-hover:scale-105 transition-transform duration-500"></div>
              )}
            </div>
            <div class="mt-3 flex justify-between text-xs tracking-widest uppercase">
              <span>{p.name}</span>
              {p.note ? <span class="text-sm md:text-base tracking-normal normal-case text-[color:var(--color-muted)]">{p.note}</span> : null}
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  {showAvailableToShip && (
    <section class="px-6 pb-32">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-baseline justify-between border-b border-[color:var(--color-ink)]/15 pb-3 mb-8">
          <h2 class="text-2xl md:text-3xl font-black tracking-[0.05em]">Available to ship</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {order.map((p) => (
            <button
              type="button"
              class="group block text-left w-full"
              data-favve-title={p.name}
              data-favve-note={p.note}
              data-favve-details={p.details?.join(" | ") ?? ""}
              data-favve-description={p.description ?? ""}
              data-favve-price={p.price ?? ""}
              data-favve-image={p.image ?? ""}
              data-favve-gallery={p.gallery?.join(" | ") ?? ""}
              data-favve-gallery-positions={p.galleryPositions?.join(" | ") ?? ""}
              data-favve-image-fit={p.imageFit ?? "cover"}
              data-favve-brand-values={p.brandValues?.join(" | ") ?? ""}
              data-favve-section="ship"
            >
              <div class="aspect-square bg-white overflow-hidden border border-black/10">
                {p.image ? (
                  <img
                    src={p.image}
                    alt={p.name}
                    loading="lazy"
                    class={`w-full h-full ${p.imageFit === "contain" ? "object-contain p-2" : "object-cover"} group-hover:scale-105 transition-transform duration-500`}
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-stone-200 to-amber-200 group-hover:scale-105 transition-transform duration-500"></div>
                )}
              </div>
              <div class="mt-3 flex justify-between text-xs tracking-widest uppercase">
                <span>{p.name}</span>
                {p.note ? <span class="text-[color:var(--color-cherry)]">{p.note}</span> : null}
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <div id="favve-modal" class="fixed inset-0 z-50 hidden bg-black/70" aria-hidden="true">
    <div class="h-full w-full overflow-y-auto">
      <div class="min-h-full bg-[color:var(--color-bg)] px-6 py-8 md:px-10 md:py-10">
        <div class="mx-auto w-full max-w-7xl">
          <div class="sticky top-0 z-10 -mx-2 mb-8 flex items-center justify-between border-b border-black/10 bg-[color:var(--color-bg)] px-2 py-3">
            <div class="text-xs tracking-[0.22em] uppercase text-[color:var(--color-muted)]">Favve Detail</div>
            <div class="flex items-center gap-2">
              <button id="favve-modal-prev" type="button" class="text-xs tracking-widest uppercase border border-black/25 px-3 py-2 hover:bg-black/5" aria-label="Previous item">← Prev</button>
              <button id="favve-modal-next" type="button" class="text-xs tracking-widest uppercase border border-black/25 px-3 py-2 hover:bg-black/5" aria-label="Next item">Next →</button>
              <button id="favve-modal-close" type="button" class="text-xs tracking-widest uppercase border border-black/25 px-4 py-2 hover:bg-black/5">Close</button>
            </div>
          </div>

          <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-start">
            <div class="mx-auto w-full max-w-[420px] md:max-w-[460px]">
              <div class="aspect-[4/5] max-h-[520px] overflow-hidden border border-black/10 bg-white">
              <img id="favve-modal-image" src="" alt="" class="h-full w-full object-cover" />
              <div id="favve-modal-image-fallback" class="hidden h-full w-full bg-gradient-to-br from-stone-200 via-amber-100 to-stone-300"></div>
              </div>
              <div id="favve-modal-thumbs" class="mt-3 grid grid-cols-3 gap-2"></div>
            </div>

            <div class="max-w-2xl">
              <div id="favve-modal-note" class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">In Store Favve</div>
              <h3 id="favve-modal-title" class="mt-3 text-4xl md:text-6xl leading-[0.95] font-brand-script normal-case">Item</h3>
              <div id="favve-modal-price" class="mt-4 text-base md:text-lg font-semibold tracking-wide">Price upon request</div>
              <div id="favve-modal-placeholder" class="mt-3"></div>
              <p id="favve-modal-description" class="mt-5 text-base md:text-lg leading-relaxed text-[color:var(--color-ink)]/85"></p>

              <div class="mt-8 border-t border-black/10 pt-6">
                <div class="font-geliat text-xs tracking-[0.2em] uppercase text-[color:var(--color-muted)]">Details</div>
                <ul id="favve-modal-list" class="font-geliat mt-4 space-y-3 text-sm md:text-base leading-relaxed"></ul>
              </div>

              <div id="favve-modal-brand-values-wrap" class="mt-8 border-t border-black/10 pt-6 hidden">
                <div id="favve-modal-brand-values-title" class="font-geliat text-xs tracking-[0.2em] uppercase text-[color:var(--color-muted)]">Brand Values</div>
                <ul id="favve-modal-brand-values" class="mt-4 flex flex-wrap gap-2"></ul>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  const favveModal = document.getElementById('favve-modal');
  const favveModalTitle = document.getElementById('favve-modal-title');
  const favveModalNote = document.getElementById('favve-modal-note');
  const favveModalPrice = document.getElementById('favve-modal-price');
  const favveModalPlaceholder = document.getElementById('favve-modal-placeholder');
  const favveModalDescription = document.getElementById('favve-modal-description');
  const favveModalList = document.getElementById('favve-modal-list');
  const favveModalBrandValuesWrap = document.getElementById('favve-modal-brand-values-wrap');
  const favveModalBrandValuesTitle = document.getElementById('favve-modal-brand-values-title');
  const favveModalBrandValues = document.getElementById('favve-modal-brand-values');
  const favveModalImage = document.getElementById('favve-modal-image');
  const favveModalImageFallback = document.getElementById('favve-modal-image-fallback');
  const favveModalThumbs = document.getElementById('favve-modal-thumbs');
  const favveModalClose = document.getElementById('favve-modal-close');
  const favveModalPrev = document.getElementById('favve-modal-prev');
  const favveModalNext = document.getElementById('favve-modal-next');
  const favveTriggers = Array.from(document.querySelectorAll('[data-favve-title]'));
  let currentFavveIndex = -1;

  const closeFavveModal = () => {
    favveModal?.classList.add('hidden');
    favveModal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  const toSlug = (value) =>
    value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');

  const openFavveByIndex = (index) => {
      if (!favveTriggers.length) return;
      const total = favveTriggers.length;
      const wrappedIndex = ((index % total) + total) % total;
      currentFavveIndex = wrappedIndex;
      const trigger = favveTriggers[wrappedIndex];
      const title = trigger.getAttribute('data-favve-title') || 'Item';
      const note = trigger.getAttribute('data-favve-note') || 'In Store Favve';
      const price = trigger.getAttribute('data-favve-price') || 'Price upon request';
      const description = trigger.getAttribute('data-favve-description') || 'Contact us for specifications, sizing, and current availability.';
      const image = trigger.getAttribute('data-favve-image') || '';
      const gallery = (trigger.getAttribute('data-favve-gallery') || '')
        .split(' | ')
        .map((item) => item.trim())
        .filter(Boolean);
      const galleryPositions = (trigger.getAttribute('data-favve-gallery-positions') || '')
        .split(' | ')
        .map((item) => item.trim())
        .filter(Boolean);
      const imageFit = trigger.getAttribute('data-favve-image-fit') || 'cover';
      const brandValues = (trigger.getAttribute('data-favve-brand-values') || '')
        .split(' | ')
        .map((item) => item.trim())
        .filter(Boolean);
      const section = trigger.getAttribute('data-favve-section') || 'in-store';
      const details = (trigger.getAttribute('data-favve-details') || '')
        .split(' | ')
        .map((item) => item.trim())
        .filter(Boolean);

      if (favveModalTitle) favveModalTitle.textContent = title;
      if (favveModalNote) favveModalNote.textContent = note;
      if (favveModalPrice) favveModalPrice.textContent = price;
      if (favveModalPlaceholder) {
        favveModalPlaceholder.innerHTML = '';
        const slot = document.createElement('div');
        slot.id = `${toSlug(title)}-btn`;
        favveModalPlaceholder.appendChild(slot);
      }
      if (favveModalDescription) {
        favveModalDescription.textContent = description;
        const shouldUseNewDescriptionFont =
          title.toLowerCase().includes('blomb') ||
          title.toLowerCase().includes('citrus + co garnish blends');
        if (shouldUseNewDescriptionFont) {
          favveModalDescription.classList.add('font-geliat');
        } else {
          favveModalDescription.classList.remove('font-geliat');
        }
      }
      if (favveModalList) {
        favveModalList.innerHTML = '';
        const items = details.length
          ? details
          : ['Message us for sourcing options and current lead times.'];
        items.forEach((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          favveModalList.appendChild(li);
        });
      }

      if (favveModalBrandValuesWrap && favveModalBrandValues) {
        favveModalBrandValues.innerHTML = '';
        if (brandValues.length) {
          if (favveModalBrandValuesTitle) {
            if (section === 'ship') {
              favveModalBrandValuesTitle.classList.add('hidden');
            } else {
              favveModalBrandValuesTitle.classList.remove('hidden');
            }
          }
          brandValues.forEach((value) => {
            const li = document.createElement('li');
            li.className = 'border border-black/15 px-3 py-1 text-xs tracking-wide uppercase';
            li.textContent = value;
            favveModalBrandValues.appendChild(li);
          });
          favveModalBrandValuesWrap.classList.remove('hidden');
        } else {
          if (favveModalBrandValuesTitle) favveModalBrandValuesTitle.classList.remove('hidden');
          favveModalBrandValuesWrap.classList.add('hidden');
        }
      }

      if (favveModalImage instanceof HTMLImageElement && favveModalImageFallback) {
        const initialImage = gallery[0] || image;
        if (initialImage) {
          favveModalImage.src = initialImage;
          favveModalImage.alt = title;
          favveModalImage.style.objectPosition = galleryPositions[0] || '50% 50%';
          favveModalImage.classList.remove('object-cover', 'object-contain', 'p-2');
          if (imageFit === 'contain') {
            favveModalImage.classList.add('object-contain', 'p-2');
          } else {
            favveModalImage.classList.add('object-cover');
          }
          favveModalImage.classList.remove('hidden');
          favveModalImageFallback.classList.add('hidden');
        } else {
          favveModalImage.removeAttribute('src');
          favveModalImage.alt = '';
          favveModalImage.classList.add('hidden');
          favveModalImageFallback.classList.remove('hidden');
        }
      }

      if (favveModalThumbs) {
        favveModalThumbs.innerHTML = '';
        gallery.forEach((src, idx) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'overflow-hidden border border-black/20 bg-white hover:border-black';
          button.setAttribute('aria-label', `View photo ${idx + 1}`);

          const thumb = document.createElement('img');
          thumb.src = src;
          thumb.alt = `${title} photo ${idx + 1}`;
          thumb.className = 'h-20 w-full object-cover';
          thumb.loading = 'lazy';

          button.appendChild(thumb);
          button.addEventListener('click', () => {
            if (favveModalImage instanceof HTMLImageElement && favveModalImageFallback) {
              favveModalImage.src = src;
              favveModalImage.alt = title;
              favveModalImage.style.objectPosition = galleryPositions[idx] || '50% 50%';
              favveModalImage.classList.remove('hidden');
              favveModalImageFallback.classList.add('hidden');
            }
          });
          favveModalThumbs.appendChild(button);
        });
      }

      favveModal?.classList.remove('hidden');
      favveModal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
  };

  favveTriggers.forEach((trigger, idx) => {
    trigger.addEventListener('click', () => {
      openFavveByIndex(idx);
    });
  });

  favveModalClose?.addEventListener('click', closeFavveModal);
  favveModalPrev?.addEventListener('click', () => {
    if (currentFavveIndex >= 0) openFavveByIndex(currentFavveIndex - 1);
  });
  favveModalNext?.addEventListener('click', () => {
    if (currentFavveIndex >= 0) openFavveByIndex(currentFavveIndex + 1);
  });

  favveModal?.addEventListener('click', (event) => {
    if (event.target === favveModal) {
      closeFavveModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeFavveModal();
      return;
    }
    if (favveModal?.classList.contains('hidden')) return;
    if (event.key === 'ArrowLeft' && currentFavveIndex >= 0) {
      openFavveByIndex(currentFavveIndex - 1);
    }
    if (event.key === 'ArrowRight' && currentFavveIndex >= 0) {
      openFavveByIndex(currentFavveIndex + 1);
    }
  });

</script>

