---
import Base from "../layouts/Base.astro";
import StatueBand from "../components/StatueBand.astro";

const inStore = [
  { name: "Travertine Side Table", note: "1 of 1", url: "/contact" },
  { name: "Cast Brass Sconce", note: "Limited", url: "/contact" },
  { name: "Earth Pigment Print", note: "Framed", url: "/contact" },
];

const order = [
  { name: "Linen Floor Lamp", note: "Made to Order", url: "#" },
  { name: "Hand-Loomed Throw", note: "Ships in 2–3 wks", url: "#" },
  { name: "Vintage Bouclé Chair", note: "Trade Account", url: "#" },
];
---

<Base title="Favves | THROWN" description="Monthly favorites — pieces in the shop and pieces you can order.">
  <StatueBand />
  <section class="px-6 pt-16 pb-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">Favves — May 2026</div>
      <h1 class="mt-3 text-5xl md:text-7xl font-black tracking-tight leading-[0.9]">
        <span class="block">FAVVES</span>
        <span class="block mt-2 text-3xl md:text-5xl font-semibold tracking-normal wave-line" aria-label="of amberwavves">
          <span class="wave-prefix" aria-hidden="true">of&nbsp;</span><span class="wave-word" aria-hidden="true"><span style="--i:0">a</span><span style="--i:1">m</span><span style="--i:2">b</span><span style="--i:3">e</span><span style="--i:4">r</span><span style="--i:5">w</span><span style="--i:6">a</span><span style="--i:7">v</span><span style="--i:8">v</span><span style="--i:9">e</span><span style="--i:10">s</span></span>
        </span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed">
        A short list of things we're loving right now — split between pieces sitting in the shop
        and pieces you can order through us. Refreshed monthly.
      </p>
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-baseline justify-between border-b border-[color:var(--color-ink)]/15 pb-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight">In Store</h2>
        <span class="text-xs tracking-widest uppercase text-[color:var(--color-muted)]">1712 Spoke St</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {inStore.map((p) => (
          <a href={p.url} class="group block">
            <div class="aspect-square bg-neutral-200 overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-amber-100 to-stone-300 group-hover:scale-105 transition-transform duration-500"></div>
            </div>
            <div class="mt-3 flex justify-between text-xs tracking-widest uppercase">
              <span>{p.name}</span>
              <span class="text-[color:var(--color-muted)]">{p.note}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 pb-32">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-baseline justify-between border-b border-[color:var(--color-ink)]/15 pb-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight">Order</h2>
        <span class="text-xs tracking-widest uppercase text-[color:var(--color-muted)]">Dropship · Trade</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {order.map((p) => (
          <a href={p.url} class="group block">
            <div class="aspect-square bg-neutral-200 overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-stone-200 to-amber-200 group-hover:scale-105 transition-transform duration-500"></div>
            </div>
            <div class="mt-3 flex justify-between text-xs tracking-widest uppercase">
              <span>{p.name}</span>
              <span class="text-[color:var(--color-cherry)]">{p.note}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .wave-line {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: nowrap;
    max-width: 100%;
    font-style: italic;
    color: var(--color-cherry);
  }

  .wave-prefix {
    flex: 0 0 auto;
    margin-right: 0.4em;
  }

  .wave-word {
    display: inline-block;
    white-space: nowrap;
    padding: 0.3em 0;
    letter-spacing: 0;
    transition: letter-spacing 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wave-line:hover .wave-word {
    letter-spacing: 0.6em;
  }

  .wave-word > span {
    display: inline-block;
    color: var(--color-cherry);
    animation: amber-wave 8s linear infinite;
    animation-delay: calc(var(--i) * -0.55s);
    will-change: transform;
  }

  @keyframes amber-wave {
    0% {
      transform: translateY(0);
    }
    12.5% {
      transform: translateY(-0.35em);
    }
    25% {
      transform: translateY(-0.5em);
    }
    37.5% {
      transform: translateY(-0.35em);
    }
    50% {
      transform: translateY(0);
    }
    62.5% {
      transform: translateY(0.18em);
    }
    75% {
      transform: translateY(0.25em);
    }
    87.5% {
      transform: translateY(0.18em);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>
