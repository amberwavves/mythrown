---
import Base from "../layouts/Base.astro";
import StatueBand from "../components/StatueBand.astro";

const services = [
  {
    title: "Redesign & Restyle",
    body: "Need a fresh new look for an existing space? We create a full furnishings and styling plan, from concept through sourcing, so every piece feels intentional. We also handle purchasing, tracking, scheduling, receiving, and installation for a seamless process and a beautifully finished result.",
  },
  {
    title: "Renovate",
    body: "From outdated kitchens to full home, office, or restaurant renovations, we design spaces that look better and function better. We partner with architects and builders to refine layouts, select quality materials, and align every detail with your style and needs.",
  },
  {
    title: "Build",
    body: "For new builds, we work with your builder, architects, and trades to shape a complete design plan. From layouts and cabinetry to paint, flooring, tile, countertops, lighting, hardware, and final details, every choice is deliberate and cohesive.",
  },
  {
    title: "Hospitality Design",
    body: "Hospitality is at the heart of what we do. With over thirteen years in the restaurant industry, we design restaurants and boutique hotels that balance atmosphere, flow, and function. Detailed renderings help you see every element before construction, so you can move forward with clarity and confidence.",
  },
];
---

<Base title="Services | THROWN">
  <StatueBand />
  <section class="px-6 pt-16 pb-12">
    <div class="max-w-7xl mx-auto">
      <div class="font-aliens-cows text-lg md:text-xl tracking-wide uppercase text-[color:var(--color-cherry)]">Services</div>
      <h1 class="mt-3 text-5xl md:text-7xl font-brand-script tracking-[0.06em] md:tracking-[0.08em]">What we do.</h1>
    </div>
  </section>

  <section class="px-6 pb-32">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-x-12 gap-y-16">
      {services.map((s, i) => (
        <div class={`service-card service-card-${(i % 4) + 1}`}>
          <h2 class="mt-3 text-2xl md:text-3xl font-brand-script tracking-[0.04em]">{s.title}</h2>
          <p class="mt-4 text-lg md:text-xl leading-relaxed font-aliens-cows">{s.body}</p>
        </div>
      ))}
    </div>

    <div class="service-card service-card-feature max-w-3xl mx-auto mt-20 text-center">
      <h2 class="mt-3 text-2xl md:text-3xl font-brand-script tracking-[0.04em]">renderings</h2>
      <p class="mt-4 text-lg md:text-xl leading-relaxed font-aliens-cows">
        At Thrown, clarity isn&rsquo;t a luxury&mdash;it&rsquo;s essential. Our true-to-scale renderings help you see every angle and detail before anything is built, from major renovations to bold finish updates. Fewer surprises, less stress, and stronger decisions from day one.
      </p>
      <div class="mt-8 flex flex-col gap-4">
        <a
          href="/3d-rendering-portfolio"
          class="inline-block font-aliens-cows bg-[#3b0f1a] text-white px-7 py-3 text-lg md:text-xl tracking-normal normal-case hover:bg-[#2f0b15] transition-colors"
        >
          Click here for our rendering portfolio
        </a>
        <a
          href="/contact"
          class="inline-block font-aliens-cows bg-[#3b0f1a] text-white px-7 py-3 text-lg md:text-xl tracking-normal normal-case hover:bg-[#2f0b15] transition-colors"
        >
          Need a designer? Let&rsquo;s chat
        </a>
      </div>
    </div>
  </section>
</Base>
