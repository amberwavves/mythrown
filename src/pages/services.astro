---
import Base from "../layouts/Base.astro";
import StatueBand from "../components/StatueBand.astro";

const services = [
  {
    title: "Redesign & Restyle",
    body: "Have an existing space that needs a fresh new look? This service delivers a comprehensive furnishings and styling design plan that transforms your space. From the initial visual conception presentation to in-depth product and materials research, every element is meticulously sourced to create a one-of-a-kind result. We handle purchasing, tracking, scheduling, receiving, and professional installation, ensuring a seamless process and a beautifully finished space.",
  },
  {
    title: "Renovate",
    body: "Whether you're in need of remodeling an outdated kitchen or renovating your entire home, office space, or even restaurant, we are here to give your space a new look and better function. We work with architects and builders to redesign layouts, choose quality materials, and make sure every detail matches your style and needs — creating a space that feels both fresh and lasting.",
  },
  {
    title: "Build",
    body: "For new builds, we collaborate with your provided builder, along with architects and the necessary tradespeople, to create a comprehensive design plan. From electrical layouts and cabinet designs to paint, flooring, tile, countertops, lighting, hardware, and finishing details, we make sure every choice feels deliberate and well crafted.",
  },
  {
    title: "Hospitality Design",
    body: "Hospitality is at the heart of what we do. With over 13 years of experience in the restaurant industry, we help design and create the restaurant or boutique hotel you have been dreaming about. Our detailed 3D renderings make it easy to visualize the project fully, bringing every element to life before construction begins so you can move forward with confidence and clarity.",
  },
];
---

<Base title="Services | THROWN">
  <StatueBand />
  <section class="px-6 pt-16 pb-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-xs tracking-widest uppercase text-[color:var(--color-cherry)]">Services</div>
      <h1 class="mt-3 text-5xl md:text-7xl font-black tracking-tight">What we do.</h1>
    </div>
  </section>

  <section class="px-6 pb-32">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-x-12 gap-y-16">
      {services.map((s, i) => (
        <div>
          <div class="text-xs tracking-widest uppercase text-[color:var(--color-muted)]">
            {String(i + 1).padStart(2, "0")}
          </div>
          <h2 class="mt-3 text-2xl md:text-3xl font-semibold">{s.title}</h2>
          <p class="mt-4 text-lg leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>

    <div class="max-w-3xl mx-auto mt-20 text-center">
      <div class="text-xs tracking-widest uppercase text-[color:var(--color-muted)]">05</div>
      <h2 class="mt-3 text-2xl md:text-3xl font-semibold">3D renderings</h2>
      <p class="mt-4 text-lg leading-relaxed">
        At Thrown, clarity isn&rsquo;t a luxury&mdash;it&rsquo;s a necessity. We know not everyone is a visual person, so we help bridge that gap with true-to-scale 3D renderings of your design. See every angle and every detail before it&rsquo;s built, whether you&rsquo;re gutting an old kitchen or adding bold new wallpaper. No surprises, just confidence, time saved, money saved, and less stress.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block bg-black text-white px-7 py-3 text-xs tracking-widest uppercase hover:bg-[color:var(--color-cherry-soft)] transition-colors"
      >
        Need a designer? Let&rsquo;s chat
      </a>
    </div>
  </section>
</Base>
